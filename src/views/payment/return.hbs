<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-6 col-lg-5">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-md-5 text-center">
                    {{#if success}}
                    <div class="mb-3">
                        <i class="bi bi-check-circle-fill" style="font-size: 4rem; color: #198754;"></i>
                    </div>
                    <h4 class="fw-bold mb-3">Thanh toán thành công</h4>
                    {{else}}
                    <div class="mb-3">
                        <i class="bi bi-x-circle-fill" style="font-size: 4rem; color: #dc3545;"></i>
                    </div>
                    <h4 class="fw-bold mb-3">Thanh toán chưa thành công</h4>
                    {{/if}}

                    <p class="text-muted">{{message}}</p>

                    {{#if orderId}}
                    <div class="table-responsive mt-4 text-start">
                        <table class="table table-sm table-borderless mb-0">
                            <tbody>
                                {{#if orderId}}
                                <tr>
                                    <td class="text-muted">Mã giao dịch</td>
                                    <td class="text-end fw-semibold">{{orderId}}</td>
                                </tr>
                                {{/if}}
                                {{#if amount}}
                                <tr>
                                    <td class="text-muted">Số tiền</td>
                                    <td class="text-end fw-semibold">{{amount}} ₫</td>
                                </tr>
                                {{/if}}
                                {{#if transId}}
                                <tr>
                                    <td class="text-muted">Mã đối tác</td>
                                    <td class="text-end fw-semibold">{{transId}}</td>
                                </tr>
                                {{/if}}
                                {{#if orderInfo}}
                                <tr>
                                    <td class="text-muted">Nội dung</td>
                                    <td class="text-end fw-semibold">{{orderInfo}}</td>
                                </tr>
                                {{/if}}
                            </tbody>
                        </table>
                    </div>
                    {{/if}}

                    <div class="d-flex justify-content-center gap-2 mt-4">
                        <a href="/" class="btn btn-outline-secondary px-4">Về trang chủ</a>
                        <a href="/orders" class="btn btn-primary px-4" style="background-color: var(--primary-sky); border-color: var(--primary-sky);">Xem đơn hàng</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
